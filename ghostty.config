# Ghostty configuration
# Managed in ~/dotfiles and symlinked to ~/.config/ghostty/config

# Theme
# Built-in popular dark theme with good contrast and modern colors.
theme = Catppuccin Mocha
window-theme = auto

# Font
# JetBrains Mono Nerd Font is installed locally and works well with prompts/icons.
font-family = JetBrainsMono Nerd Font Mono
font-size = 11
adjust-cell-height = 5%

# Window appearance
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.96
background-blur-radius = 20
macos-titlebar-style = transparent

# Cursor / terminal behavior
cursor-style = block
cursor-style-blink = true
shell-integration = detect
mouse-hide-while-typing = true
scrollback-limit = 10000000

# macOS ergonomics
macos-option-as-alt = true
quit-after-last-window-closed = true
confirm-close-surface = false

# Keep config reloads explicit and predictable.
auto-update = check
